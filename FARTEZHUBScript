-- ฟังก์ชันสร้างปุ่มเกมหลัก
-- ==========================================
local SelectedScript = nil 
local AllPlayButtons = {} 

local function CreateGameButton(gameName, systemText, universeId, scriptToRun)
    local GameFrame = Instance.new("Frame")
    local GameCorner = Instance.new("UICorner")
    local GameIcon = Instance.new("ImageLabel") 
    local IconCorner = Instance.new("UICorner")
    local GameTitle = Instance.new("TextLabel")
    local SystemLabel = Instance.new("TextLabel")
    local PlayButton = Instance.new("TextButton")
    local PlayCorner = Instance.new("UICorner")

    GameFrame.Name = gameName
    GameFrame.Parent = ScrollingFrame
    GameFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    GameFrame.Size = UDim2.new(1, -10, 0, 60)
    GameCorner.CornerRadius = UDim.new(0, 8)
    GameCorner.Parent = GameFrame

    GameIcon.Name = "GameIcon"
    GameIcon.Parent = GameFrame
    GameIcon.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    GameIcon.BackgroundTransparency = 1 
    GameIcon.Position = UDim2.new(0, 15, 0, 10) 
    GameIcon.Size = UDim2.new(0, 40, 0, 40) 
    
    if type(universeId) == "number" then
        GameIcon.Image = "rbxthumb://type=GameIcon&id=" .. tostring(universeId) .. "&w=150&h=150" 
    else
        GameIcon.Image = universeId
    end

    IconCorner.CornerRadius = UDim.new(0, 8) 
    IconCorner.Parent = GameIcon

    GameTitle.Parent = GameFrame
    GameTitle.BackgroundTransparency = 1
    GameTitle.Position = UDim2.new(0, 70, 0, 10) 
    GameTitle.Size = UDim2.new(0, 200, 0, 20)
    GameTitle.Font = Enum.Font.GothamBold
    GameTitle.Text = gameName
    GameTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    GameTitle.TextSize = 14
    GameTitle.TextXAlignment = Enum.TextXAlignment.Left

    SystemLabel.Parent = GameFrame
    SystemLabel.BackgroundTransparency = 1
    SystemLabel.Position = UDim2.new(0, 70, 0, 30)
    SystemLabel.Size = UDim2.new(0, 200, 0, 20)
    SystemLabel.Font = Enum.Font.Gotham
    SystemLabel.Text = systemText
    SystemLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    SystemLabel.TextSize = 12
    SystemLabel.TextXAlignment = Enum.TextXAlignment.Left

    PlayButton.Parent = GameFrame
    PlayButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255) 
    PlayButton.Position = UDim2.new(1, -90, 0, 15)
    PlayButton.Size = UDim2.new(0, 80, 0, 30)
    PlayButton.Font = Enum.Font.GothamBold
    PlayButton.Text = "PLAY"
    PlayButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    PlayButton.TextSize = 12
    PlayCorner.CornerRadius = UDim.new(0, 6)
    PlayCorner.Parent = PlayButton

    table.insert(AllPlayButtons, PlayButton)

    PlayButton.MouseButton1Click:Connect(function()
        for _, btn in pairs(AllPlayButtons) do
            btn.Text = "PLAY"
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        end
        PlayButton.Text = "SELECTED"
        PlayButton.BackgroundColor3 = Color3.fromRGB(0, 255, 127) 
        SelectedScript = scriptToRun
    end)
end

