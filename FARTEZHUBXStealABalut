local function GetZoneCenterFromServer(zoneId)
    local r = RS:GetAttribute("ZoneRange" .. zoneId)
    if r and typeof(r) == "Vector2" then
        local midX = (r.X + r.Y) / 2
        local ch = player.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local y = hrp and hrp.Position.Y or 10
        return Vector3.new(midX, y, -364)
    end
    return ZoneCenters[zoneId]
end

local function DoFarmPhase()
    local ch = player.Character
    if not ch then return end
    if State.AutoEquip then EquipBestAsarol() end

    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local egg = FindNearestEgg(State.TargetZone)
    if not egg then
        local centerPos = GetZoneCenterFromServer(State.TargetZone)
        if centerPos then
            local flat = Vector3.new(centerPos.X, hrp.Position.Y, centerPos.Z)
            local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(flat.X, 0, flat.Z)).Magnitude
            if dist > 40 then
                WalkTo(flat, 15, 15)
                return
            end
        end
        local t = tick() * 0.5
        local wobble = Vector3.new(math.sin(t) * 20, hrp.Position.Y, math.cos(t) * 20)
        WalkTo(wobble, 10, 3)
        return
    end

    local hb = egg.PrimaryPart or egg:FindFirstChild("Hitbox")
    if not hb then return end
    
    local dx = hrp.Position.X - hb.Position.X
    local dz = hrp.Position.Z - hb.Position.Z
    local flatDist = math.sqrt(dx * dx + dz * dz)
    
    if flatDist > 12 then
        local travelTime = math.clamp(flatDist / 50 + 3, 5, 30)
        local targetPos = Vector3.new(hb.Position.X, hrp.Position.Y, hb.Position.Z)
        WalkTo(targetPos, 6, travelTime)
        return
    end

    hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
    EquipMartilyo()
    task.wait(0.1)
    if Remotes and Remotes:FindFirstChild("HitEgg") then
        Remotes.HitEgg:FireServer(egg)
    end
    task.wait(0.4)
end

local function MasterLoop()
    while State.AutoFarm or State.AutoSteal do
        local didSomething = false
        
        pcall(function()
            local carryingAttr = player:GetAttribute("Carrying")
            
            if carryingAttr == nil and State.IsStealingActive then
                State.IsStealingActive = false
            end

            if carryingAttr ~= nil or State.IsStealingActive then
                local ch = player.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if hrp and hum then
                    SyncSpeed()
                    hum:MoveTo(CustomDropPos)
                end
                task.wait(0.2)
                return
            end

            if State.AutoSteal and State.LastDropPos and carryingAttr == nil then
                local recovered = RecoverDroppedPet()
                if recovered then
                    didSomething = true
                    task.wait(0.2)
                end
            end

            if not didSomething and State.AutoSteal then
                local canSteal = (tick() - (State.LastStealTime or 0)) >= (State.StealCooldown or 3)
                if canSteal then
                    local bestTarget = FindBestStealTarget()
                    if bestTarget then
                        State.IsStealingActive = true
                        local ok = DoStealPhase()
                        State.IsStealingActive = false
                        if ok then
                            didSomething = true
                            task.wait(0.5)
                        end
                    end
                end
            end

            if not didSomething and State.AutoFarm and not State.IsStealingActive and carryingAttr == nil then
                DoFarmPhase()
                didSomething = true
            end

            if not didSomething then
                task.wait(0.3)
            end
        end)
        
        task.wait(0.1)
    end
    State.IsStealingActive = false
end

local function StartMaster()
    if State.MasterThread then return end
    State.MasterThread = task.spawn(MasterLoop)
end

local function StopMaster()
    if State.MasterThread then
        pcall(task.cancel, State.MasterThread)
        State.MasterThread = nil
    end
end

local function StartFarm() State.AutoFarm = true; StartMaster() end
local function StopFarm() State.AutoFarm = false; if not State.AutoSteal then StopMaster() end end
local function StartSteal() State.AutoSteal = true; StartMaster() end
local function StopSteal() State.AutoSteal = false; if not State.AutoFarm then StopMaster() end end

local function GetAllBackpackPets()
    local pets = {}
    local ch = player.Character
    local containers = { player:FindFirstChildOfClass("Backpack"), ch }
    for _, container in ipairs(containers) do
        if not container then continue end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local uid = tool:GetAttribute("PetUid")
                if uid then
                    local petId = tool:GetAttribute("PetId")
                    local cfg = GameConfig and GameConfig.GetPet(petId)
                    table.insert(pets, {
                        Tool = tool, Uid = uid, PetId = petId,
                        Name = cfg and cfg.Name or tool.Name,
                        Rarity = cfg and cfg.Rarity or "Common",
                        Kg = tool:GetAttribute("Kg") or 0,
                        IsLocked = tool:GetAttribute("L") == true,
                    })
                end
            end
        end
    end
    return pets
end

