local function UpdateSummary()
    local zones = State.FilterZones or {}
    local rarities = State.FilterRarities
    local minIncome = State.FilterMinIncome or 0

    local zList = {}
    for id, sel in pairs(zones) do
        if sel then table.insert(zList, id) end
    end
    table.sort(zList)
    local zText
    if #zList == 0 then
        zText = "All Zones"
    elseif #zList <= 3 then
        local names = {}
        for _, id in ipairs(zList) do
            table.insert(names, "Z" .. id)
        end
        zText = table.concat(names, ", ")
    else
        zText = #zList .. " Zones"
    end

    local rList = {}
    for r, v in pairs(rarities) do if v then table.insert(rList, r) end end
    local rText = #rList == 0 and "All Rarities" or table.concat(rList, ", ")

    local iText = minIncome <= 0 and "Any Income" or ("≥ $" .. FormatSpeed(minIncome) .. "/s")

    SummaryLabel.TextColor3 = Theme.Success

    local speedInfo = ""
    if #zList > 0 then
        local maxRec = 0
        local maxZ = nil
        for _, id in ipairs(zList) do
            local rec = ZoneRecommended[id] or 0
            if rec > maxRec then maxRec = rec; maxZ = id end
        end
        local mySpeed = 0
        pcall(function() mySpeed = player:GetAttribute("Speed") or 0 end)
        local status = mySpeed < maxRec and "⚠️" or "✅"
        speedInfo = string.format("\nMax Z%d: %s (You: %s) %s",
            maxZ or 0, FormatSpeed(maxRec), FormatSpeed(mySpeed), status)
    end

    SummaryLabel.Size = UDim2.new(1, -20, 0, 56)
    SummaryLabel.Text = "Steal: " .. zText .. " · " .. rText .. "\nIncome: " .. iText .. speedInfo
end

