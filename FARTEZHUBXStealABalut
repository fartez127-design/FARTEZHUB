local function GetStealPrompt(pet)
    if not pet then return nil end
    local allPrompts = {}

    for _, obj in ipairs(pet:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled and obj.Parent then
            table.insert(allPrompts, obj)
        end
    end

    if #allPrompts == 0 and pet.Parent then
        for _, obj in ipairs(pet.Parent:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Enabled and obj.Parent then
                table.insert(allPrompts, obj)
            end
        end
    end

    if #allPrompts == 0 then return nil end

    local ch = player.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if hrp and #allPrompts > 1 then
        table.sort(allPrompts, function(a, b)
            local pa = a.Parent and a.Parent.Position or Vector3.zero
            local pb = b.Parent and b.Parent.Position or Vector3.zero
            return (pa - hrp.Position).Magnitude < (pb - hrp.Position).Magnitude
        end)
    end
    return allPrompts[1]
end

