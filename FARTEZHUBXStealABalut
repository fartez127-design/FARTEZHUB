local function GetTrisikadPart()
    local plot = GetOwnPlot()
    if not plot then return nil end
    local trisikad = plot:FindFirstChild("Trisikad")
    if not trisikad then return nil end
    local seat = trisikad:FindFirstChild("DriverSeat", true)
    if seat then return seat end
    local promptPart = trisikad:FindFirstChild("PromptPart", true)
    if promptPart then return promptPart end
    return trisikad.PrimaryPart or trisikad:FindFirstChildWhichIsA("BasePart")
end

local WalkToTrisikadThread = nil
MKToggle(CollectTab, "Auto Walk to Trisikad/Tricycle", false, function(enabled)
    if enabled then
        if WalkToTrisikadThread then return end
        State.AutoWalkToTrisikad = true
        WalkToTrisikadThread = task.spawn(function()
            while State.AutoWalkToTrisikad do
                pcall(function()
                    local ch = player.Character
                    if not ch then task.wait(1) return end
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    if not hrp or not hum then task.wait(1) return end
                    if ch:GetAttribute("RideKind") then task.wait(1) return end
                    local target = GetTrisikadPart()
                    if not target then task.wait(1) return end
                    if (hrp.Position - target.Position).Magnitude > 8 then
                        WalkTo(target.Position, 6, 10)
                    else
                        local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if not prompt and target.Parent then
                            prompt = target.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
                        end
                        if prompt then
                            local originalHold = prompt.HoldDuration; prompt.HoldDuration = 0
                            pcall(function()
                                if type(fireproximityprompt) == "function" then fireproximityprompt(prompt)
                                else prompt:InputHoldBegin(); prompt:InputHoldEnd() end
                            end)
                            prompt.HoldDuration = originalHold
                        end
                        task.wait(2)
                    end
                end)
                RunService.Heartbeat:Wait()
            end
            WalkToTrisikadThread = nil
        end)
    else
        State.AutoWalkToTrisikad = false
        if WalkToTrisikadThread then pcall(task.cancel, WalkToTrisikadThread); WalkToTrisikadThread = nil end
        pcall(function() RS.Remotes.TrisikadDismount:FireServer() end)
    end
end)

