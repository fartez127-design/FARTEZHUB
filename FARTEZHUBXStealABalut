local function DoStealPhase()
    local ch = player.Character
    if not ch then return false end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    if tick() - (State.LastStealTime or 0) < (State.StealCooldown or 3) then
        return false
    end

    local target = FindPriorityTarget()
    if not target then
        target = FindBestStealTarget()
        if not target then 
            local hasAnyFilter = false
            for _, sel in pairs(State.FilterZones or {}) do if sel then hasAnyFilter = true break end end
            for _, sel in pairs(State.FilterRarities or {}) do if sel then hasAnyFilter = true break end end
            if (State.FilterMinIncome or 0) > 0 then hasAnyFilter = true end
            
            if hasAnyFilter then
                local savedZones = State.FilterZones
                local savedRar = State.FilterRarities
                local savedInc = State.FilterMinIncome
                State.FilterZones = {}
                State.FilterRarities = {}
                State.FilterMinIncome = 0
                target = FindBestStealTarget()
                State.FilterZones = savedZones
                State.FilterRarities = savedRar
                State.FilterMinIncome = savedInc
            end
            if not target then return false end
        end
    end

    local root = target:FindFirstChild("RootPart") or target.PrimaryPart
    if not root then return false end

    RememberTarget(target)

    local function FlatDist(a, b)
        return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
    end

    local function GetClosestPartDistance(model, pos)
        local closest = math.huge
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1 then
                local d = (part.Position - pos).Magnitude
                if d < closest then closest = d end
            end
        end
        return closest
    end

    local t0 = tick()
    local reached = false
    while tick() - t0 < 45 do
        if not target.Parent or target:GetAttribute("State") ~= "Wild" then 
            ForgetTarget(); return false
        end
        ch = player.Character
        if not ch then return false end
        hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        local petKg = target:GetAttribute("Kg") or 0
        local isJumbo = target:FindFirstChild("Jumbo") or target.Name:find("Jumbo")

        local stopDist = 8
        if isJumbo or petKg > 100000 then stopDist = 16 end
        if petKg > 500000 then stopDist = 20 end

        local flatD = FlatDist(hrp.Position, root.Position)
        local closestD = GetClosestPartDistance(target, hrp.Position)
        local effectiveD = math.min(flatD, closestD)

        if effectiveD <= stopDist then reached = true; break end

        local hum = ch:FindFirstChildOfClass("Humanoid")
        if hum then 
            SyncSpeed()
            hum:MoveTo(Vector3.new(root.Position.X, hrp.Position.Y, root.Position.Z))
            if flatD < 15 and hum.FloorMaterial ~= Enum.Material.Air then
                hum.Jump = true
            end
        end
        task.wait(0.25)
    end

    if not reached then 
        local promptCheck = GetStealPrompt(target)
        if not promptCheck then
            AddToBlacklist(target, "Timeout")
            return false 
        end
    end

    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    task.wait(0.15)
    
    local prompt = GetStealPrompt(target)
    if not prompt then
        local tWait = tick()
        while tick() - tWait < 1.5 do
            prompt = GetStealPrompt(target)
            if prompt then break end
            RunService.Heartbeat:Wait()
        end
    end
    
    if not prompt then
        AddToBlacklist(target, "No prompt")
        return false
    end

    if prompt.Parent and prompt.Parent:IsA("BasePart") then
        local pp = prompt.Parent
        local maxD = (prompt.MaxActivationDistance or 10) * 0.6
        local dir = (hrp.Position - pp.Position)
        if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) else dir = dir.Unit end
        hrp.CFrame = CFrame.new(pp.Position + dir * maxD)
        task.wait(0.2)
    end

    local gotCarry = ForceSteal(target, prompt)

    if not gotCarry then
        local prompt2 = GetStealPrompt(target)
        if prompt2 and prompt2.Parent and prompt2.Parent:IsA("BasePart") then
            local pp = prompt2.Parent
            local maxD = (prompt2.MaxActivationDistance or 10) * 0.5
            local dir = (hrp.Position - pp.Position)
            if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) else dir = dir.Unit end
            hrp.CFrame = CFrame.new(pp.Position + dir * maxD)
            task.wait(0.3)
            gotCarry = ForceSteal(target, prompt2)
        end
    end

    if not gotCarry then 
        AddToBlacklist(target, "Fail")
        return false
    end

    State.IsStealingActive = true

    FreezeMyPlot(true)
    if State.AutoBoostOnCarry then
        EnableBoostFPS()
        State._autoBoosted = true
    end

    if SmartDrop() then
        FreezeMyPlot(false)
        if State._autoBoosted and State.AutoBoostOnCarry then
            DisableBoostFPS()
            State._autoBoosted = nil
        end
        State.LastStealTime = tick()
        ForgetTarget()
        State.IsStealingActive = false
        return true
    end

    local tDrop = tick()
    local dropSuccess = false
    local lastRetarget = 0
    
    while tick() - tDrop < 60 do
        if player:GetAttribute("Carrying") == nil then 
            dropSuccess = true
            break 
        end
        
        ch = player.Character
        if not ch then break end
        hrp = ch:FindFirstChild("HumanoidRootPart")
        if not hrp then break end
        
        local distToSafe = (hrp.Position - CustomDropPos).Magnitude
        
        if distToSafe <= 15 then
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum then
                SyncSpeed()
                local dir = (CustomDropPos - hrp.Position).Unit
                hum:MoveTo(CustomDropPos)
                hrp.AssemblyLinearVelocity = Vector3.new(
                    dir.X * 60,
                    hrp.AssemblyLinearVelocity.Y,
                    dir.Z * 60
                )
            end
            task.wait(0.1)
            
            if distToSafe <= 6 then
                hrp.AssemblyLinearVelocity = Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)
                pcall(function()
                    if Remotes and Remotes:FindFirstChild("DropPet") then
                        Remotes.DropPet:FireServer()
                    end
                end)
                task.wait(0.3)
                if player:GetAttribute("Carrying") == nil then 
                    dropSuccess = true 
                    break 
                end
            end
        else
            if tick() - lastRetarget > 0.5 then
                lastRetarget = tick()
                local hum = ch:FindFirstChildOfClass("Humanoid")
                if hum then 
                    SyncSpeed()
                    hum:MoveTo(CustomDropPos) 
                end
            end
            task.wait(0.1)
        end
    end
    
    FreezeMyPlot(false)
    if State._autoBoosted and State.AutoBoostOnCarry then
        DisableBoostFPS()
        State._autoBoosted = nil
    end

    State.IsStealingActive = false

    if dropSuccess then 
        State.LastStealTime = tick()
        ForgetTarget()
    end
    return dropSuccess
end

local function Boost_HideOtherPlots()
    local plots = WS:FindFirstChild("Map") and WS.Map:FindFirstChild("Plots")
    if not plots then return 0 end
    local myPlotId = player:GetAttribute("PlotId")
    local myPlotName = myPlotId and ("Plot" .. tostring(myPlotId)) or nil
    local hidden = 0
    for _, plot in ipairs(plots:GetChildren()) do
        if not plot:IsA("Model") then continue end
        if plot.Name ~= myPlotName then
            if plot.Parent == plots then
                State.BoostBackup[plot] = plot.Parent
                plot.Parent = nil
                hidden = hidden + 1
            end
        end
    end
    return hidden
end

local function Boost_HideZoneDecor()
    local decor = WS:FindFirstChild("Map") and WS.Map:FindFirstChild("Decor")
    if not decor then return 0 end
    
    local HIDE_FOLDERS = {
        "ZoneSets", "Props", "Halaman", "Damo", "SideDecor",
        "SlabFiller", "Banderitas", "Tarps", "KuralBorder",
        "MirrorRight", "Ambience", "Halloween", "PowerLines", "SolarPoste"
    }
    
    local hidden = 0
    for _, folderName in ipairs(HIDE_FOLDERS) do
        local folder = decor:FindFirstChild(folderName)
        if not folder then continue end
        if folder.Parent == decor then
            State.BoostBackup[folder] = decor
            folder.Parent = nil
            hidden = hidden + 1
        end
    end
    
    for _, subName in ipairs({ "ZoneSlabs", "ZoneFloors" }) do
        local sub = decor:FindFirstChild(subName)
        if not sub then continue end
        for _, zoneObj in ipairs(sub:GetChildren()) do
            local zoneId = tonumber(zoneObj.Name:match("%d+"))
            if State.BoostKeepZone > 0 and zoneId == State.BoostKeepZone then
                continue
            end
            if zoneObj.Parent == sub then
                State.BoostBackup[zoneObj] = sub
                zoneObj.Parent = nil
                hidden = hidden + 1
            end
        end
    end
    return hidden
end

local function Boost_LowGraphics(enable)
    local Lighting = game:GetService("Lighting")
    
    if enable then
        State.BoostLightingBackup = State.BoostLightingBackup or {
            GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        }
        
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0
        
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") and effect.Name ~= "FARTEZ_Boost" then
                effect.Enabled = false
            end
        end
        
        local terrain = WS:FindFirstChildOfClass("Terrain")
        if terrain then
            pcall(function()
                terrain.WaterWaveSize = 0
                terrain.WaterWaveSpeed = 0
                terrain.WaterReflectance = 0
                terrain.WaterTransparency = 1
                terrain.Decoration = false
            end)
        end
        
        for _, obj in ipairs(WS:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") then
                local playerChar = player.Character
                if playerChar and obj:IsDescendantOf(playerChar) then continue end
                local AE = WS:FindFirstChild("ActiveEggs")
                if AE and obj:IsDescendantOf(AE) then continue end
                local AG = WS:FindFirstChild("AbuseGames")
                if AG and obj:IsDescendantOf(AG) then continue end
                
                if obj.Enabled then obj.Enabled = false end
            elseif obj:IsA("PointLight") or obj:IsA("SpotLight") or obj:IsA("SurfaceLight") then
                local playerChar = player.Character
                if playerChar and obj:IsDescendantOf(playerChar) then continue end
                if obj.Enabled then obj.Enabled = false end
            elseif obj:IsA("BasePart") then
                if obj.CastShadow then obj.CastShadow = false end
            end
        end
    else
        if State.BoostLightingBackup then
            Lighting.GlobalShadows = State.BoostLightingBackup.GlobalShadows
            Lighting.FogEnd = State.BoostLightingBackup.FogEnd
            Lighting.EnvironmentDiffuseScale = State.BoostLightingBackup.EnvironmentDiffuseScale
            Lighting.EnvironmentSpecularScale = State.BoostLightingBackup.EnvironmentSpecularScale
        end
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") then effect.Enabled = true end
        end
    end
end

local function EnableBoostFPS()
    if State.BoostFPS then return end
    State.BoostFPS = true
    State.BoostBackup = {}
    
    Boost_HideOtherPlots()
    Boost_HideZoneDecor()
    
    if State.BoostLowGraphics then
        Boost_LowGraphics(true)
    end
    
    local UserSettings = game:GetService("UserSettings"):GetService("UserGameSettings")
    pcall(function()
        State.BoostSettingsBackup = State.BoostSettingsBackup or {
            SavedQualityLevel = UserSettings.SavedQualityLevel.Value,
        }
        UserSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
    end)
end

local function DisableBoostFPS()
    if not State.BoostFPS then return end
    State.BoostFPS = false
    
    for obj, parent in pairs(State.BoostBackup) do
        pcall(function()
            if obj and obj.Parent == nil then
                obj.Parent = parent
            end
        end)
    end
    State.BoostBackup = {}
    
    if State.BoostLowGraphics then
        Boost_LowGraphics(false)
    end
    
    local UserSettings = game:GetService("UserSettings"):GetService("UserGameSettings")
    pcall(function()
        if State.BoostSettingsBackup then
            UserSettings.SavedQualityLevel = State.BoostSettingsBackup.SavedQualityLevel
        end
    end)
end

local function AutoBoostWhileCarrying()
    if player:GetAttribute("Carrying") ~= nil then
        if not State.BoostFPS and State.AutoBoostOnCarry then
            EnableBoostFPS()
            State._autoBoosted = true
        end
    else
        if State._autoBoosted and State.AutoBoostOnCarry then
            DisableBoostFPS()
            State._autoBoosted = nil
        end
    end
end

