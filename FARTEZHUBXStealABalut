local function MoveTo_Game(target, maxWait)
    maxWait = maxWait or 20
    local ch = player.Character
    if not ch then return false end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    SyncSpeed()
    if (hrp.Position - target).Magnitude < 5 then return true end
    hum:MoveTo(target)

    local t = tick()
    local lastMoveTo = tick()
    local lastPos = hrp.Position
    local stuckTime = 0
    local lastStuckCheck = tick()
    
    while tick() - t < maxWait do
        if not hrp.Parent then return false end
        SyncSpeed()
        if (hrp.Position - target).Magnitude < 5 then return true end
        
        if tick() - lastStuckCheck > 0.3 then
            local moved = (hrp.Position - lastPos).Magnitude
            if moved < 1.5 then
                stuckTime = stuckTime + 0.3
                if hum.FloorMaterial ~= Enum.Material.Air then
                    hum.Jump = true
                end
                if stuckTime > 1.5 then
                    local side = (math.random() < 0.5) and -1 or 1
                    local escapeDir = Vector3.new(math.random(-1, 1) * 25, 0, side * 25)
                    hum:MoveTo(hrp.Position + escapeDir)
                    task.wait(0.6)
                    stuckTime = 0
                end
            else
                stuckTime = 0
            end
            lastPos = hrp.Position
            lastStuckCheck = tick()
        end
        
        if tick() - lastMoveTo > 0.5 then
            hum:MoveTo(target)
            lastMoveTo = tick()
        end
        RunService.Heartbeat:Wait()
    end
    return false
end

local function WalkTo(target, stopDist, maxWait)
    local ch = player.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    if hrp then
        target = Vector3.new(target.X, hrp.Position.Y, target.Z)
    end
    return MoveTo_Game(target, maxWait or 20)
end

