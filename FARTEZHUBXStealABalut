local function FormatSpeed(n)
    if not n or n <= 0 then return "0" end
    if n >= 1e12 then return string.format("%.1fT", n / 1e12) end
    if n >= 1e9  then return string.format("%.1fB", n / 1e9) end
    if n >= 1e6  then return string.format("%.1fM", n / 1e6) end
    if n >= 1e3  then return string.format("%.1fK", n / 1e3) end
    return tostring(n)
end

local function ParseIncome(str)
    if not str or str == "" then return 0 end
    str = tostring(str):lower():gsub("%s", ""):gsub(",", "")
    if str == "" then return 0 end
    local mult = 1
    local suffix = str:sub(-1)
    if suffix == "k" then mult = 1e3;   str = str:sub(1, -2)
    elseif suffix == "m" then mult = 1e6;   str = str:sub(1, -2)
    elseif suffix == "b" then mult = 1e9;   str = str:sub(1, -2)
    elseif suffix == "t" then mult = 1e12;  str = str:sub(1, -2)
    end
    local num = tonumber(str)
    if not num then return 0 end
    return math.floor(num * mult)
end

local function SpeedColor(n)
    if not n or n <= 0    then return Color3.fromRGB(150, 150, 150) end
    if n <= 100           then return Color3.fromRGB(51, 255, 0)
    elseif n <= 10000     then return Color3.fromRGB(0, 217, 255)
    elseif n <= 1000000   then return Color3.fromRGB(255, 138, 0)
    elseif n <= 1e9       then return Color3.fromRGB(255, 26, 168)
    else                       return Color3.fromRGB(255, 26, 26)
    end
end

