local function FindBestStealTarget()
    local WP = WS:FindFirstChild("WildPets")
    if not WP then return nil end
    local ch = player.Character
    if not ch then return nil end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local fZones = State.FilterZones
    local fRarities = State.FilterRarities
    local fMinIncome = State.FilterMinIncome or 0

    local anyZoneSelected = false
    for _, sel in pairs(fZones or {}) do if sel then anyZoneSelected = true; break end end

    local hasRarityFilter = false
    for _, isSel in pairs(fRarities) do
        if isSel then hasRarityFilter = true break end
    end

    local maxDist = anyZoneSelected and 10000 or math.huge
    local candidates = {}

    for _, pet in ipairs(WP:GetChildren()) do
        if not pet:IsA("Model") then continue end
        if pet:GetAttribute("State") ~= "Wild" then continue end
        if IsBlacklisted(pet) then continue end

        local petId = pet:GetAttribute("PetId")
        if not petId then continue end
        local cfg = GameConfig and GameConfig.GetPet(petId)
        if not cfg then continue end

        if anyZoneSelected then
            local pz = cfg.Zone or 0
            if pz == 0 then pz = 7 end
            if not fZones[pz] then
                local attrZone = pet:GetAttribute("Zone") or pet:GetAttribute("ZoneId")
                if attrZone and fZones[tonumber(attrZone)] then
                    pz = tonumber(attrZone)
                end
            end
            if not fZones[pz] then continue end
        end

        if hasRarityFilter then
            local ok = false
            for rName, isSel in pairs(fRarities) do
                if isSel and string.lower(tostring(cfg.Rarity)) == string.lower(tostring(rName)) then
                    ok = true break
                end
            end
            if not ok then continue end
        end

        local income = GetPetIncome(pet)
        if income <= 0 then
            if GameConfig and GameConfig.RarityIncome then
                income = GameConfig.RarityIncome[cfg.Rarity] or 1
            else
                income = 1
            end
        end
        if fMinIncome > 0 and income < fMinIncome then continue end

        local root = pet:FindFirstChild("RootPart") or pet.PrimaryPart
        if not root then continue end

        local d = (root.Position - hrp.Position).Magnitude
        if d > maxDist then continue end

        table.insert(candidates, {
            pet = pet,
            income = income,
            dist = d,
            root = root,
            rarity = cfg.Rarity or "Common",
            name = cfg.Name or petId,
        })
    end

    if #candidates == 0 then return nil end

    local RARITY_BONUS = {
        Common = 1, Uncommon = 1.2, Rare = 1.5, Epic = 2, Legendary = 3,
        Mythic = 4, Divine = 5, Secret = 6, Celestial = 7, Cosmic = 8, Godly = 9
    }

    local mode = State.TargetMode or "income"
    for _, c in ipairs(candidates) do
        local rarityK = RARITY_BONUS[c.rarity] or 1
        if mode == "nearest" then
            c.score = 1 / (1 + c.dist)
        elseif mode == "balanced" then
            c.score = (c.income * rarityK) / (1 + c.dist / 200)
        else
            c.score = (c.income * rarityK) / (1 + c.dist / 100)
        end
    end

    table.sort(candidates, function(a, b)
        return a.score > b.score
    end)

    return candidates[1].pet
end

