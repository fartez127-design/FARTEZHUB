local sellAllLastClick = 0
SellAllBtn.MouseButton1Click:Connect(function()
    local ch = player.Character
    if not ch then return end
    
    if tick() - sellAllLastClick < 3 then
        SellAllIncludeLocked = not SellAllIncludeLocked
    else
        SellAllIncludeLocked = false
    end
    sellAllLastClick = tick()
    
    local pets = GetAllBackpackPets()
    local toSell = {}
    local skippedLocked = 0
    for _, pet in ipairs(pets) do
        if pet.IsLocked and not SellAllIncludeLocked then
            skippedLocked = skippedLocked + 1
            continue
        end
        table.insert(toSell, pet.Uid)
    end
    
    if #toSell == 0 then
        SellAllState.Text = "⚠️ No sellable pets" .. (skippedLocked > 0 and (" (Locked " .. skippedLocked .. ")") or "")
        task.delay(3, function() SellAllState.Text = "Click again = Include Locked" end)
        return
    end
    
    if Remotes and Remotes:FindFirstChild("PetAction") then
        task.spawn(function()
            local total = #toSell
            local sent = 0
            for i = 1, #toSell, 50 do
                local chunk = {}
                for j = i, math.min(i + 49, #toSell) do
                    table.insert(chunk, toSell[j])
                end
                pcall(function()
                    Remotes.PetAction:InvokeServer("Sell", chunk)
                end)
                sent = sent + #chunk
                SellAllState.Text = "Selling... " .. sent .. "/" .. total
                task.wait(0.2)
            end
            SellAllState.Text = "✅ Sold " .. total .. " pets" .. (SellAllIncludeLocked and " (Included Locked)" or "")
            task.delay(3, function() SellAllState.Text = "Click again = Include Locked" end)
        end)
    end
end)

