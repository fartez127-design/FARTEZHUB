local function UpdateBackpackDropdownText()
    local count = 0
    for _, v in pairs(State.SelectedBackpackUids) do if v then count = count + 1 end end
    BackpackBtn.Text = count == 0 and "Select Items" or (count .. " Items Selected")
end

local function RefreshBackpackDropdownMenu()
    for _, c in ipairs(BackpackPopup:GetChildren()) do
        if c:IsA("TextButton") and c ~= CloseBackpackPopup then c:Destroy() end
    end
    local items = GetAllBackpackPets()
    if #items == 0 then
        local emptyLbl = Instance.new("TextButton", BackpackPopup)
        emptyLbl.Size = UDim2.new(1, -16, 0, 32); emptyLbl.BackgroundColor3 = Theme.SurfaceLight
        emptyLbl.Text = "No Pets Found in Backpack"; emptyLbl.TextColor3 = Theme.TextDim
        emptyLbl.TextSize = 11; emptyLbl.Font = Enum.Font.GothamBold
        emptyLbl.LayoutOrder = 1; emptyLbl.ZIndex = 101
        Instance.new("UICorner", emptyLbl).CornerRadius = UDim.new(0, 6)
        return
    end
    table.sort(items, function(a, b)
        local order = GameConfig and GameConfig.RarityOrder or {}
        local idxA, idxB = 99, 99
        for i, r in ipairs(order) do
            if r == a.Rarity then idxA = i end
            if r == b.Rarity then idxB = i end
        end
        return idxA < idxB
    end)
    for i, item in ipairs(items) do
        local isSel = State.SelectedBackpackUids[item.Uid] == true
        local itemBtn = Instance.new("TextButton", BackpackPopup)
        itemBtn.Size = UDim2.new(1, -16, 0, 36); itemBtn.BackgroundColor3 = isSel and Theme.Accent or Theme.SurfaceLight
        local lockIcon = item.IsLocked and "🔒 " or ""
        itemBtn.Text = string.format("%s%s☐ %s (%s)", (isSel and "☑ " or ""), lockIcon, item.Name, item.Rarity)
        itemBtn.TextColor3 = isSel and Color3.new(0,0,0) or (GameConfig.Rarities[item.Rarity] or Theme.Text)
        itemBtn.TextSize = 10; itemBtn.Font = Enum.Font.GothamBold
        itemBtn.LayoutOrder = i; itemBtn.ZIndex = 101
        Instance.new("UICorner", itemBtn).CornerRadius = UDim.new(0, 6)
        itemBtn.MouseButton1Click:Connect(function()
            if item.IsLocked then return end
            State.SelectedBackpackUids[item.Uid] = not State.SelectedBackpackUids[item.Uid]
            local selected = State.SelectedBackpackUids[item.Uid]
            itemBtn.BackgroundColor3 = selected and Theme.Accent or Theme.SurfaceLight
            itemBtn.TextColor3 = selected and Color3.new(0,0,0) or (GameConfig.Rarities[item.Rarity] or Theme.Text)
            itemBtn.Text = string.format("%s%s☐ %s (%s)", (selected and "☑ " or ""), lockIcon, item.Name, item.Rarity)
            UpdateBackpackDropdownText()
        end)
    end
end
BackpackBtn.MouseButton1Click:Connect(function()
    RefreshBackpackDropdownMenu(); BackpackPopup.Visible = not BackpackPopup.Visible
end)

