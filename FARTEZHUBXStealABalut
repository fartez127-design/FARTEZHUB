-- ============================================================
local function ForceSteal(pet, prompt)
    if not pet or not prompt then return false end

    local function waitCarry(timeout)
        local t = tick()
        while tick() - t < (timeout or 2) do
            if player:GetAttribute("Carrying") ~= nil then return true end
            RunService.Heartbeat:Wait()
        end
        return false
    end

    if not prompt.Parent then return false end

    local function teleportToPrompt()
        local pp = prompt.Parent
        if not (pp and pp:IsA("BasePart")) then return false end
        local ch = player.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        local maxD = (prompt.MaxActivationDistance or 10) * 0.6
        local dir = (hrp.Position - pp.Position)
        if dir.Magnitude < 0.5 then
            dir = Vector3.new(0, 0, 1)
        else
            dir = dir.Unit
        end
        hrp.CFrame = CFrame.new(pp.Position + dir * maxD)
        return true
    end

    teleportToPrompt()
    task.wait(0.15)
    local origHold = prompt.HoldDuration
    prompt.HoldDuration = 0
    pcall(function()
        if type(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        end
    end)
    task.wait(0.25)
    prompt.HoldDuration = origHold
    if waitCarry(2) then return true end

    teleportToPrompt()
    task.wait(0.2)
    prompt.HoldDuration = 0
    pcall(function()
        if type(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        end
        prompt:InputHoldBegin()
        task.wait(0.05)
        prompt:InputHoldEnd()
    end)
    prompt.HoldDuration = origHold
    if waitCarry(2.5) then return true end

    local holdTime = math.max(origHold or 1, 0.1)
    prompt.HoldDuration = holdTime
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(holdTime + 0.15)
        prompt:InputHoldEnd()
    end)
    if waitCarry(3) then return true end

    for i = 1, 3 do
        teleportToPrompt()
        task.wait(0.15)
        prompt.HoldDuration = 0
        pcall(function()
            if type(fireproximityprompt) == "function" then
                fireproximityprompt(prompt)
            end
            prompt:InputHoldBegin()
            task.wait(0.05)
            prompt:InputHoldEnd()
        end)
        prompt.HoldDuration = origHold
        if waitCarry(1.5) then return true end
        task.wait(0.2)
    end

    return false
end

local function RecoverDroppedPet()
    local now = tick()
    if not State.LastDropPos then return false end
    if State.LastDropTime and (now - State.LastDropTime > 30) then
        State.LastDropPos = nil
        return false
    end
    
    local ch = player.Character
    if not ch then return false end
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    if player:GetAttribute("Carrying") ~= nil then
        State.LastDropPos = nil
        return false
    end
    
    local dropPos = State.LastDropPos
    local dist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(dropPos.X, 0, dropPos.Z)).Magnitude
    if dist > 60 then
        State.LastDropPos = nil
        return false
    end
    
    local inSafe = hrp.Position.X < (GameConfig and GameConfig.Guards and GameConfig.Guards.SafeX or 555)
    if inSafe then
        State.DropRecoverTries = (State.DropRecoverTries or 0) + 1
        if State.DropRecoverTries > 3 then
            State.LastDropPos = nil
            State.DropRecoverTries = 0
            return false
        end
        WalkTo(Vector3.new(dropPos.X, hrp.Position.Y, dropPos.Z), 6, 5)
        task.wait(0.3)
        local WP = WS:FindFirstChild("WildPets")
        if WP then
            local checked = 0
            for _, pet in ipairs(WP:GetChildren()) do
                if checked >= 5 then break end
                if not pet:IsA("Model") then continue end
                if pet:GetAttribute("State") ~= "Wild" then continue end
                local root = pet:FindFirstChild("RootPart") or pet.PrimaryPart
                if not root then continue end
                checked = checked + 1
                if (root.Position - hrp.Position).Magnitude < 10 then
                    local prompt = GetStealPrompt(pet)
                    if prompt then
                        prompt.HoldDuration = 0.01
                        pcall(function()
                            if type(fireproximityprompt) == "function" then
                                fireproximityprompt(prompt)
                            else
                                prompt:InputHoldBegin(); prompt:InputHoldEnd()
                            end
                        end)
                        task.wait(0.5)
                        if player:GetAttribute("Carrying") ~= nil then
                            State.LastDropPos = nil
                            State.DropRecoverTries = 0
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

