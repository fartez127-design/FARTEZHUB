local function FindNearestEgg(zoneId)
    local AE = WS:FindFirstChild("ActiveEggs")
    if not AE then return nil end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local zoneRange = RS:GetAttribute("ZoneRange" .. zoneId)
    if not zoneRange then
        local center = ZoneCenters[zoneId]
        if center then
            zoneRange = Vector2.new(center.X - 400, center.X + 400)
        else
            return nil
        end
    end
    
    local nearest, minD = nil, math.huge
    
    for _, egg in ipairs(AE:GetChildren()) do
        if not egg:IsA("Model") then continue end
        if egg:GetAttribute("Hatching") then continue end
        if (egg:GetAttribute("HP") or 0) <= 0 then continue end
        
        local hb = egg.PrimaryPart or egg:FindFirstChild("Hitbox")
        if not hb then continue end
        
        local x = hb.Position.X
        if x < zoneRange.X or x >= zoneRange.Y then continue end
        
        local d = (hb.Position - hrp.Position).Magnitude
        if d < minD then 
            minD = d
            nearest = egg 
        end
    end
    
    return nearest
end

